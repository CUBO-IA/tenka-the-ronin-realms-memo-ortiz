# Puerto del servidor
PORT=3000

# Ruta del archivo SQLite (opcional; por defecto tenka.db en la raíz)
# RUTA_DB=tenka.db

# URL pública del túnel de Cloudflare, para que el QR funcione desde el celular.
# Si está vacía y abriste la computadora como localhost, el servidor usa la IP
# de la red local (por ejemplo http://192.168.1.20:3000).
URL_PUBLICA=

# --- IA del juego (hito 3). Con cualquiera de las dos llaves el rōnin piensa;
# sin llaves usa mensajes predefinidos. Groq va primero, Gemini de respaldo.
GROQ_API_KEY=
GROQ_MODELO=              # por defecto llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODELO=            # por defecto gemini-3.5-flash-lite
GEMINI_MODELO_RESPALDO=   # por defecto gemini-2.5-flash-lite; se usa si el principal falla

# --- Notificaciones (hito 5) ---
VAPID_PUBLICA=
VAPID_PRIVADA=

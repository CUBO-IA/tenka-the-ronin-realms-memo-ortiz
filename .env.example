# Puerto del servidor
PORT=3000

# Ruta del archivo SQLite (opcional; por defecto tenka.db en la raíz)
# RUTA_DB=tenka.db

# URL pública del túnel de Cloudflare, para que el QR funcione desde el celular.
# Si está vacía, el servidor usa la dirección con la que se abrió la página.
URL_PUBLICA=

# --- Hitos siguientes (todavía no se usan) ---
GROQ_API_KEY=
GROQ_MODELO=
GEMINI_API_KEY=
GEMINI_MODELO=
VAPID_PUBLICA=
VAPID_PRIVADA=
